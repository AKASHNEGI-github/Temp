      "created": 1794378029992,
      "link": null,
      "locked": false,
      "text": "State -> Stateful (server stores session data in memory, a database, or Redis)",
      "fontSize": 39.81621389982872,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "State -> Stateful (server stores session data in memory, a database, or Redis)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FBFtK-UpMUheBxNMpT1FK",
      "type": "text",
      "x": 229.71892937969005,
      "y": 864.8102568806871,
      "width": 1742.1299383212738,
      "height": 55.50211710840552,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 896689812,
      "version": 284,
      "versionNonce": 493379732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794391224907,
      "created": 1794378047055,
      "link": null,
      "locked": false,
      "text": "Database Lookups -> Required on every request to validate the session ID.",
      "fontSize": 44.401693686724414,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Database Lookups -> Required on every request to validate the session ID.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "q9wo7pNYL21TVeKuUUHU8",
      "type": "text",
      "x": 220.7645139943191,
      "y": 980.315687516879,
      "width": 2057.6492124402466,
      "height": 66.96581657564431,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 1919516972,
      "version": 301,
      "versionNonce": 1547120148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794391224907,
      "created": 1794378073338,
      "link": null,
      "locked": false,
      "text": "Revokation -> Instant (server deletes or invalidates the session immediately).",
      "fontSize": 53.57265326051545,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Revokation -> Instant (server deletes or invalidates the session immediately).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "InajQUkQD7YuWw50poUqM",
      "type": "text",
      "x": 2913.153251789195,
      "y": 540.2189837882595,
      "width": 2063.1038787409034,
      "height": 57.55901501926517,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1286833068,
      "version": 362,
      "versionNonce": 46693548,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794390999830,
      "created": 1794378156019,
      "link": null,
      "locked": false,
      "text": "Storage -> Client stores the JWT (in cookies or local storage) and sends it with requests.",
      "fontSize": 46.047212015412136,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Storage -> Client stores the JWT (in cookies or local storage) and sends it with requests.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "MyIXK0Q99p8KUo2_8SrtV",
      "type": "text",
      "x": 2908.631582503069,
      "y": 688.5650360686656,
      "width": 1633.6987991795806,
      "height": 51.614744023959446,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 1633562156,
      "version": 309,
      "versionNonce": 1233908756,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794390999830,
      "created": 1794378156019,
      "link": null,
      "locked": false,
      "text": "State -> Stateless (token contains all necessary claims and user data)",
      "fontSize": 41.291795219167554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "State -> Stateless (token contains all necessary claims and user data)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WG0UgWNHYTVJkOp1b3D3n",
      "type": "text",
      "x": 2916.214715764428,
      "y": 944.5360734910912,
      "width": 2074.594170411727,
      "height": 51.614744023959446,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
