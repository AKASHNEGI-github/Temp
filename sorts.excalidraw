      "version": 326,
      "versionNonce": 1550583596,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794390999830,
      "created": 1794378156019,
      "link": null,
      "locked": false,
      "text": "Revokation -> Delayed (token remains valid until expiration unless using blacklists or short lifespans).",
      "fontSize": 41.291795219167554,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Revokation -> Delayed (token remains valid until expiration unless using blacklists or short lifespans).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
